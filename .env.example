# Database (PostgreSQL 16)
DATABASE_URL=postgres://gaps:gaps@localhost:5432/gaps

# Auth & origin check
SESSION_SECRET=replace-with-at-least-32-random-bytes-for-local-dev
APP_BASE_URL=http://localhost:3000

# AI / LLM (disabled by default; ZDR must be confirmed in writing before enabling)
LLM_PROVIDER=disabled
OPENAI_API_KEY=
LLM_MODEL_TUTOR=
LLM_MODEL_PARSE=
LLM_TIMEOUT_MS=8000
LLM_DAILY_CALLS_PER_STUDENT=40
LLM_PRICE_IN_PER_MTOK_INR=0
LLM_PRICE_OUT_PER_MTOK_INR=0
AI_ZDR_CONFIRMED=false

# Feature flags & content/seed defaults
FEATURE_SOLVE_WITH_ME=true
CONTENT_SERVE_DRAFTS=true
SEED_DEMO=true

