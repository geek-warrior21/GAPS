    "db:reset": "tsx src/reset.ts"
  },
  "dependencies": {
    "@gaps/content": "workspace:*",
    "@gaps/contracts": "workspace:*",
    "@gaps/domain": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "drizzle-kit": "^0.31.11"
  }
}
