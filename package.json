{
  "name": "gaps",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "pnpm --filter @gaps/web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "pnpm -r typecheck",
    "lint": "eslint . && pnpm --filter @gaps/web lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @gaps/db db:migrate",
    "db:seed": "pnpm --filter @gaps/db db:seed",
    "db:reset": "pnpm --filter @gaps/db db:reset",
    "content:check": "pnpm --filter @gaps/content content:check",
    "content:preview": "pnpm --filter @gaps/content content:preview",
    "verify": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test && pnpm build",
    "test:e2e": "pnpm --filter @gaps/web test:e2e"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "fast-check": "^4.10.2",
    "prettier": "^3.8.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.56.0",
    "vitest": "^5.1.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "22.23.5",
      "onFail": "download"
    }
  }
}
